# Never commit real credentials. Kite access tokens normally need periodic renewal.


# Required in addition to --live --confirm-live PLACE_ORDERS.
KITE_LIVE_TRADING=DISABLED

STRATEGY_MODEL=momentum
STRATEGY_CAPITAL=100000
EXECUTION_MODE=dry_run

# The included artifacts use a proxy universe and live mode is blocked by default.
# Keep this disabled; official point-in-time membership should be exported instead.
ALLOW_PROXY_UNIVERSE=NO

# First-run full deployment. Auto-enabled when the model has no prior submissions
# and no managed holdings; set YES to force it, plus FORCE=YES if the signal date
# was already submitted. MAX_WEIGHT caps any single name during the top-up pass.
BOOTSTRAP=NO
FORCE=NO
MAX_WEIGHT=0.10

# YES = every NSE holding in the Kite account is treated as bot-managed
# (no mark_managed step). Set NO if you hold personal stocks the bot must leave alone.
MANAGE_ALL_HOLDINGS=YES

# Personal holdings the bot must never trade (comma-separated).
UNMANAGED_SYMBOLS=
